<article id="<%= dom_id(column) %>" class="kanban-column" data-kanban-target="column" data-column-id="<%= column.id %>" data-action="dragover->kanban#dragover dragleave->kanban#dragleave drop->kanban#drop">
  <header class="column-header">
    <div class="column-title">
      <h2><%= column.name %></h2>
      <span><%= pluralize(column.cards.size, "card") %></span>
    </div>
    <div class="column-meta">
      <% if column.wip_limit.present? %>
        <span class="wip-limit">WIP <%= column.wip_limit %></span>
      <% end %>
      <button type="button" class="column-edit-btn" aria-label="Edit column" data-action="modal#open" data-column-id="<%= column.id %>" title="Edit column">Edit</button>
    </div>
  </header>

  <div
    class="card-list"
  >
    <% column.cards.each do |card| %>
      <%= render "cards/card", card: card, users: users %>
    <% end %>
  </div>

  <%= form_with model: [column, Card.new(priority: "medium")], class: "new-card-form" do |form| %>
    <%= form.text_field :title, placeholder: "New card title", required: true %>
    <div class="form-row">
      <%= form.select :priority, Card::PRIORITIES.map { |priority| [priority.titleize, priority] } %>
      <%= form.select :assignee_id, [["Unassigned", ""]] + users.map { |user| [user.name, user.id] } %>
    </div>
    <%= form.submit "Add card" %>
  <% end %>
</article>
