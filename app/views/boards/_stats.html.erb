<%= turbo_frame_tag "board_stats" do %>
  <div class="board-stats">
    <span><strong><%= board.columns.sum { |column| column.cards.size } %></strong> cards</span>
    <span class="assignees">
      <strong><%= users.size %></strong> people
      <button class="edit-assignees" data-action="modal#open" data-modal-url="<%= assignees_board_path %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V12h2.293z"/>
        </svg>
      </button>
    </span>
  </div>
<% end %>
