<main class="app-shell">
  <header class="board-header">
    <div class="header-content">
      <p class="eyebrow">Kanban POC</p>
      <h1 id="board_name"><%= @board.name %></h1>
      <p id="board_description"><%= @board.description %></p>
    </div>
    <%= render "boards/stats", board: @board, users: @users %>  </header>

  <nav class="board-menu">
    <div class="menu-left">
      <span class="keyboard-hint"><strong>Ctrl+C</strong> to copy a card | <strong>Ctrl+V</strong> to paste</span>
    </div>
    <div class="menu-right">
      <button class="menu-btn" title="Clear board" onclick="if(confirm('Clear all cards? This cannot be undone.')) { location.href = '/boards/clear'; }">
        Clear
      </button>
      <button class="menu-btn" title="Board settings" data-action="modal#open" data-modal-url="<%= edit_board_path %>">
        Settings
      </button>
    </div>
  </nav>

  <section class="board" data-controller="kanban">
    <% @board.columns.each do |column| %>
      <%= render "column", column: column, users: @users, card: @card %>
    <% end %>
  </section>
</main>
