<article
  id="<%= dom_id(card) %>"
  class="kanban-card priority-<%= card.priority.presence || "none" %>"
  draggable="true"
  data-card-id="<%= card.id %>"
  data-action="dragstart->kanban#dragstart dragend->kanban#dragend click->kanban#selectCard dblclick->modal#open"
>
  <div class="card-header-edit">
    <div class="card-topline">
      <span class="priority"><%= (card.priority.presence || "none").titleize %></span>
      <% if card.estimate.present? %>
        <span class="estimate"><%= card.estimate %> pt</span>
      <% end %>
    </div>
    <button type="button" class="card-edit-btn" aria-label="Edit card" data-action="modal#open" data-card-id="<%= card.id %>" title="Edit card">Edit</button>
  </div>

  <h3><%= card.title %></h3>
  <% if card.description.present? %>
    <p><%= card.description %></p>
  <% end %>

  <% if card.custom_fields.any? %>
    <div class="custom-fields">
      <% card.custom_fields.each do |key, value| %>
        <div class="custom-field">
          <strong><%= key %>:</strong> <%= value %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if card.label_list.any? %>
    <div class="labels">
      <% card.label_list.each do |label| %>
        <% bg_color = card.label_color(label) %>
        <% text_color = card.text_color_for_bg(bg_color) %>
        <span style="background-color: <%= bg_color %>; color: <%= text_color %>;"><%= label %></span>
      <% end %>
    </div>
  <% end %>

  <footer>
    <%= form_with model: card, class: "assignee-form" do |form| %>
      <%= form.select :assignee_id, [["Unassigned", ""]] + users.map { |user| [user.name, user.id] }, {}, onchange: "this.form.requestSubmit()" %>
    <% end %>
    <% if card.due_on.present? %>
      <time datetime="<%= card.due_on.iso8601 %>"><%= card.due_on.strftime("%b %-d") %></time>
    <% end %>
  </footer>
</article>